{
  "build": {
    "arduino":{
        "ldscript": "esp32s3_out.ld",
        "partitions": "custom_8Mb.csv"
      },
    "core": "esp32",
    "extra_flags": [
        "-DESP32S3_WAVESHARE35",
        "-DARDUINO_ESP32S3_DEV",
        "-DST7796_DRIVER=1",
        "-DHAS_SCREEN=1",
	      "-DHAS_TOUCH=1",
        "-DUSER_SETUP_LOADED=1",
        "-DARDUINO_USB_MODE=1",
        "-DARDUINO_RUNNING_CORE=1",
        "-DARDUINO_EVENT_RUNNING_CORE=1",
        "-DARDUINO_USB_CDC_ON_BOOT"
      ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s3",
    "variant": "pinouts"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "usb"
  ],
  "debug": {
    "openocd_board": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Waveshare ESP32-S3 Touch LCD 3.5",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 524288,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://www.waveshare.com/wiki/ESP32-S3-Touch-LCD-3.5B",
  "vendor": "Waveshare"
}
